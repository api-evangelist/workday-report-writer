                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/data?query=<string>&limit=20&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "data"
              ],
              "query": [
                {
                  "description": "(Required) WQL query string using SQL-like syntax. Example: SELECT workdayID, fullName FROM workers WHERE supervisoryOrganization = 'IT Department' ORDER BY fullName LIMIT 100",
